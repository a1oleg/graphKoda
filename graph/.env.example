# Скопируйте в graph/.env. Настоящие секреты не коммитьте.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8791

RUNTIME_STORAGE_BACKEND=redis
RUNTIME_REDIS_URL=redis://127.0.0.1:6379
RUNTIME_REDIS_NAMESPACE=runtime
RUNTIME_RELAY_URL=http://127.0.0.1:8787/graph-relay

# managed: coldKode пробует CLI, Docker/Podman, Neo4j Desktop или WSL.
# external: Neo4j запускается пользователем отдельно.
NEO4J_LAUNCH_MODE=managed

