                <mxCell id="annotation-mtcxywq2" value="Проверяет, осталось ли поле ввода в том же состоянии, в котором был принят input: input — обрабатываемый снимок запроса, а inputValueRef.current — синхронное зеркало актуального текста в интерфейсе. true означает, что пользователь не успел ввести новый текст; false — что поле уже содержит более новое значение." style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;verticalAlign=top;spacing=6;resizable=1;" parent="fold-row-20" annotationTargetId="n182" graphKind="Annotation" annotationToolGitCommitShortHash="3abd65a5a7a5" annotationMaxDepth="4" vertex="1">
