                <mxCell id="annotation-mu9oohhs" value="queryModel выдаёт результат постепенно: события потока StreamEvent, сообщения ассистента AssistantMessage или сообщения об ошибке API SystemAPIErrorMessage. Вызывающий код может получать их по мере готовности, не дожидаясь завершения всего ответа. void означает, что после завершения генератора отдельного итогового значения нет." style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=14;align=center;verticalAlign=top;spacing=6;resizable=1;editable=1;" parent="f0-n1-return-signature" annotationTargetId="f0-n1-return-signature-method" annotationSavedText="queryModel выдаёт результат постепенно: события потока StreamEvent, сообщения ассистента AssistantMessage или сообщения об ошибке API SystemAPIErrorMessage. Вызывающий код может получать их по мере готовности, не дожидаясь завершения всего ответа. void означает, что после завершения генератора отдельного итогового значения нет." graphKind="Annotation" annotationToolGitCommitShortHash="cd542e836252" annotationMaxDepth="0" vertex="1">
