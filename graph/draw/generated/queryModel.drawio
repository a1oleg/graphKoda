                <mxCell id="annotation-mu9oohhs" annotationMaxDepth="0" annotationSavedText="queryModel выдаёт результат постепенно: события потока StreamEvent, сообщения ассистента AssistantMessage или сообщения об ошибке API SystemAPIErrorMessage. Вызывающий код может получать их по мере готовности, не дожидаясь завершения всего ответа. void означает, что после завершения генератора отдельного итогового значения нет." annotationTargetId="f0-n1-return-signature-method" annotationToolGitCommitShortHash="cd542e836252" graphKind="Annotation" parent="f0-n1-return-signature" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=14;align=center;verticalAlign=top;spacing=6;resizable=1;editable=1;" value="queryModel выдаёт результат постепенно: события потока StreamEvent, сообщения ассистента AssistantMessage или сообщения об ошибке API SystemAPIErrorMessage. Вызывающий код может получать их по мере готовности, не дожидаясь завершения всего ответа. void означает, что после завершения генератора отдельного итогового значения нет." vertex="1">
