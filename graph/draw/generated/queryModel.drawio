                <mxCell id="annotation-mu9nvbx1" annotationMaxDepth="0" annotationSavedText="thinkingConfig — настройки режима рассуждения модели перед ответом, а не текст самих рассуждений. Поле type задаёт режим; disabled отключает его, а budgetTokens задаёт бюджет токенов на рассуждение. Основной цикл передаёт настройки из контекста работы с инструментами; ряд служебных запросов явно отключает этот режим." annotationTargetId="f0-n4" annotationToolGitCommitShortHash="d2877c942709" graphKind="Annotation" parent="f0-fold-row-4" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=14;align=center;verticalAlign=top;spacing=6;resizable=1;editable=1;" value="thinkingConfig — настройки режима рассуждения модели перед ответом, а не текст самих рассуждений. Поле type задаёт режим; disabled отключает его, а budgetTokens задаёт бюджет токенов на рассуждение. Основной цикл передаёт настройки из контекста работы с инструментами; ряд служебных запросов явно отключает этот режим." vertex="1">
                    <mxGeometry height="102" width="676" x="380" y="20" as="geometry"/>
                </mxCell>
