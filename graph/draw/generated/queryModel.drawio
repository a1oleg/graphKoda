                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="annotation-muaqvd26" annotationMaxDepth="0" annotationSavedText="Проверяет, выбрана ли одна из штатных моделей Opus. Для других моделей пропускает проверку аварийного отключения, не дожидаясь загрузки конфигурации GrowthBook." annotationTargetId="f0-n12" annotationToolGitCommitShortHash="" graphKind="Annotation" parent="f0-fold-row-15" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=14;align=center;verticalAlign=top;spacing=6;resizable=1;editable=1;" value="Проверяет, выбрана ли одна из штатных моделей Opus. Для других моделей пропускает проверку аварийного отключения, не дожидаясь загрузки конфигурации GrowthBook." vertex="1">
