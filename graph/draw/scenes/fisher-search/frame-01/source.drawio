                </object>
                <object label="Меняет местами текущий и выбранный элементы массива. В текущую позицию записывает выбранный элемент, а на его место — заранее сохранённое текущее значение." annotationOwnerStableId="examples/fisher-yates/src/shuffle.ts:40:0:43:1" revealOrder="2" annotationSource="authored-scene-snippet" id="snippet-swap">
