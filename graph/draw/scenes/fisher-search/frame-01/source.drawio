                <object label="Выбирает случайный целый индекс от нуля до переданной границы, не включая её. Math.random задаёт случайное число, Math.floor округляет результат вниз." annotationOwnerStableId="examples/fisher-yates/src/shuffle.ts:35:0:38:1" revealOrder="1" annotationSource="authored-scene-snippet" id="snippet-random">
