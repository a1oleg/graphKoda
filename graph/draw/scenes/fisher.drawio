"e-1091602a888aee95c33421dd" relationshipId="5:53195ceb-011e-4e83-a520-fe67045788e3:1159712088419992448" label="AST_CHILD"><mxCell edge="1" parent="1" source="n-9f82312b8ad3d0e7d3d5e29d" target="n-8e8589fc3e84f22862228de0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#64748b;exitX=0.5;exitY=1;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245.25" y="558"/></Array></mxGeometry></mxCell></object><object id="e-2c862bcbd3b0686e6dfdade9" relationshipId="5:53195ceb-011e-4e83-a520-fe67045788e3:1152948992397542264" label="CALLS"><mxCell edge="1" parent="1" source="n-a4081a24b021d822799d8276" target="n-19b86d3cb977fe7ebba186fa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#64748b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object><object id="e-3e79253d71d695aaeb04e609" relationshipId="5:53195ceb-011e-4e83-a520-fe67045788e3:1152948992397542270" label="CALLS"><mxCell edge="1" parent="1" source="n-8e8589fc3e84f22862228de0" target="n-29d9c6caab83f4738fb898b0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#64748b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object><object id="snippet-random" label="Выбирает случайный целый индекс от нуля до переданной границы, не включая её. Math.random задаёт случайное число, Math.floor округляет результат вниз." annotationOwnerStableId="examples/fisher-yates/src/shuffle.ts:35:0:38:1" revealOrder="1" annotationSource="authored-scene-snippet"><mxCell vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=16;fontColor=#173b3e;fillColor=#f0f7f5;strokeColor=#7ea59d;"><mxGeometry x="1224" y="300" width="340" height="156" as="geometry"/></mxCell></object><object id="snippet-swap" label="Меняет местами текущий и выбранный элементы массива. В текущую позицию записывает выбранный элемент, а на его место — заранее сохранённое текущее значение." annotationOwnerStableId="examples/fisher-yates/src/shuffle.ts:40:0:43:1" revealOrder="2" annotationSource="authored-scene-snippet"><mxCell vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=16;fontColor=#173b3e;fillColor=#f0f7f5;strokeColor=#7ea59d;"><mxGeometry x="1224" y="520" width="340" height="156" as="geometry"/></mxCell></object><object id="snippet-shuffle" label="Перемешивает алфавит, проходя его с конца. На каждом шаге getRandom выбирает индекс в оставшейся части, а swap меняет выбранный элемент с текущим. Обработанная часть растёт; функция возвращает перемешанный массив." annotationOwnerStableId="examples/fisher-yates/src/shuffle.ts:6:7:33:1" revealOrder="3" annotationSource="authored-scene-snippet"><mxCell vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=16;fontColor=#173b3e;fillColor=#f0f7f5;strokeColor=#7ea59d;"><mxGeometry x="394.25" y="80.5" width="540" height="156" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>