                <mxCell id="annotation-shuffle" annotationOwnerCellId="c8" annotationSavedText="Перемешивает алфавит, проходя его с конца. На каждом шаге getRandom выбирает индекс в оставшейся части, а swap меняет выбранный элемент с текущим. Обработанная часть растёт; функция возвращает перемешанный массив." annotationSource="scene-row022-1789542834324742500/stage3/source.drawio#snippet-shuffle" graphKind="Annotation" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacing=10;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#000000;" value="...&#xa;проверяет какая модель выбрана и доступна ли она&#xa;..." vertex="1">
