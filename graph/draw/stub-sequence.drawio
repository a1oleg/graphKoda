                <mxCell id="c33" value="yield события и сообщения" style="html=0;fontFamily=Arial;fontSize=14;fontColor=#1963a6;strokeColor=#1963a6;strokeWidth=2;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" parent="1" edge="1">
