{
  "name": "graphKoda-graph-explorer",
  "displayName": "graphKoda Graph Explorer",
  "description": "VS Code graph explorer for function diagrams.",
  "version": "0.0.437",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:graphKodaGraphExplorer.openFisherYates",
    "onUri",
    "onView:graphKodaGraphExplorer.functions",
    "onCommand:graphKodaGraphExplorer.openNode",
    "onCommand:graphKodaGraphExplorer.openRuntimeAnalysis",
    "onCommand:graphKodaGraphExplorer.openHelpersFunctionalSegment",
    "onCommand:graphKodaGraphExplorer.runStubApp",
    "onCommand:graphKodaGraphExplorer.refresh"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphKodaGraphExplorer.openFisherGraphScene",
        "title": "Фишер: управляемая сцена графа"
      },
      {
        "command": "graphKodaGraphExplorer.demoStep",
        "title": "Demo: execute a structured step"
      },
      {
        "command": "graphKodaGraphExplorer.openFisherYates",
        "title": "Нарисовать Фишера"
      },
      {
        "command": "graphKodaGraphExplorer.openNode",
        "title": "Open Graph Diagram"
      },
      {
        "command": "graphKodaGraphExplorer.openRuntimeAnalysis",
        "title": "Open Runtime Analysis"
      },
      {
        "command": "graphKodaGraphExplorer.openHelpersFunctionalSegment",
        "title": "Draw Helpers Functional Segment"
      },
      {
        "command": "graphKodaGraphExplorer.refresh",
        "title": "Refresh Graph Explorer"
      },
      {
        "command": "graphKodaGraphExplorer.runStubApp",
        "title": "Run App (Stub)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphKodaGraphExplorer",
          "title": "Graph Explorer",
          "icon": "media/graph-flow.svg"
        }
      ]
    },
    "views": {
      "graphKodaGraphExplorer": [
        {
          "id": "graphKodaGraphExplorer.functions",
          "name": "Graph Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "graphKodaGraphExplorer.refresh",
          "when": "view == graphKodaGraphExplorer.functions",
          "group": "navigation"
        }
      ]
    }
  }
}
