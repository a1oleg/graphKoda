{
  "name": "coldkode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.6 || ^24",
    "npm": "^10.8 || ^11"
  },
  "scripts": {
    "fisher:example": "node --import tsx examples/fisher-yates/src/main.ts",
    "fisher:test": "node --import tsx --test examples/fisher-yates/src/shuffle.test.ts dev/fisherYates.test.mjs",
    "fisher:import": "node --import tsx dev/importFisherYates.mjs && node dev/materializeFisherYatesContext.mjs",
    "fisher:draw": "node dev/exportFisherYatesDrawio.mjs",
    "test": "node --test graph/packages/orchestrator/src/orchestrator/*.test.js graph/packages/runtime-relay/src/*.test.mjs graph/vscode-extension/*.test.js dev/functionDiagramScope.structure.test.mjs dev/runtimePathDrawio.test.mjs dev/runtimeSetValues.test.mjs dev/runtimeTraceStableId.test.mjs dev/stableId.test.mjs",
    "test:instrumentation": "node --test dev/nodePassInstrumentationCompile.test.mjs",
    "test:renderer": "node --test dev/localCoordinateDrawio.structure.test.mjs",
    "graph:orchestrator": "node ./dev/startOrchestrator.mjs",
    "graph:orchestrator:ensure": "node ./dev/ensureOrchestrator.mjs",
    "graph:orchestrator:check": "node ./dev/checkOrchestratorHealth.mjs",
    "graph:neo4j:start": "node ./dev/neo4j/startNeo4jServer.mjs",
    "graph:redis:up": "docker compose -f docker-compose.redis.yml up -d",
    "graph:redis:down": "docker compose -f docker-compose.redis.yml down --remove-orphans",
    "graph:redis:logs": "docker compose -f docker-compose.redis.yml logs -f redis",
    "graph:relay:redis": "node ./dev/redis/startRuntimeRelayToRedis.mjs",
    "graph:extract:func": "node ./dev/runGraphExtract.mjs func",
    "graph:extract:scoped-server": "node --import tsx ./dev/scopedFunctionExtractorServer.mts",
    "graph:mcp:neo4j": "python ./graph/mcp/neo4j_mcp_server.py",
    "graph:mcp:redis": "node ./graph/mcp/redis_mcp_server.mjs",
    "graph:codeql:storage": "node ./dev/codeqlStructuralStorageFacts.mjs",
    "graph:codeql:canonical": "node ./dev/codeqlCanonicalReferenceLinks.mjs",
    "graph:extension:test": "node --test graph/vscode-extension/*.test.js",
    "graph:extension:package": "npx @vscode/vsce package --cwd graph/vscode-extension"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@duckdb/node-api": "^1.5.4-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^4.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "jsonc-parser": "^3.3.1",
    "lucide": "^1.43.0",
    "neo4j-driver": "^6.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^5.12.1",
    "swagger-ui-dist": "^5.32.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "zod": "^4.4.3"
  }
}
